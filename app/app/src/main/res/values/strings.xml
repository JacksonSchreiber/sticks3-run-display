    <string name="permission_title">Permissions</string>
    <string name="permission_rationale">Bluetooth is needed to read the chest strap and to write to the RunStick. Location is needed because pace comes from GPS — nothing is stored or sent anywhere. Notifications are needed for the ongoing run notification. In Simulate mode, location is not requested.</string>
    <string name="grant_permissions">Grant permissions</string>
    <string name="permissions_ok">All permissions granted</string>

    <string name="need_strap">Pick a chest strap first, or turn on Simulate.</string>
    <string name="need_stick">Pick the RunStick first.</string>

    <string name="battery_title">Keeping it alive for a long run</string>
    <string name="battery_help">Android will happily kill this app after an hour in your pocket. On a Samsung, open Settings → Apps → RunStick → Battery and choose <b>Unrestricted</b>, then Settings → Battery → Background usage limits and add RunStick to <b>Never auto sleeping apps</b>. The button below asks Android to exempt the app from battery optimisation, which covers the generic case.</string>
    <string name="battery_exempt">Ignore battery optimisation</string>
    <string name="battery_already_exempt">Already exempt from battery optimisation</string>
