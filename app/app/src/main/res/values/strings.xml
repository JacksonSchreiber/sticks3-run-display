    <string name="max_hr_highest">Highest in your saved runs: %1$d bpm (the highest heart rate held for %2$d seconds, so short strap spikes don\'t count)</string>
    <string name="max_hr_zone_note" formatted="false">These are standard % of max HR zones (Z1 under 60%, Z2 60-70%, Z3 70-80%, Z4 80-90%, Z5 90%+). Strava\'s zones can differ unless you set Strava\'s to match.</string>
